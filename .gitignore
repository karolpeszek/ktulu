# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — projekt używa pnpm; obce pliki blokady nie trafiają do repozytorium,
# bo Cloudflare Pages wybiera menedżera pakietów po obecności pliku blokady
/node_modules
package-lock.json
yarn.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
