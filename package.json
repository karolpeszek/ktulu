{
  "name": "ktulu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gen-bootstrap.mjs --force && pnpm run verify && next build && node scripts/gen-sw.mjs",
    "preview": "pnpm dlx serve out -l 4173",
    "dev:worker": "wrangler dev",
    "deploy": "pnpm run build && pnpm dlx wrangler deploy",
    "deploy:podglad": "npx wrangler versions upload --preview-alias $(node scripts/alias-podgladu.mjs)",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:lobby": "node scripts/test-lobby.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "verify": "node scripts/gen-bootstrap.mjs && pnpm run lint && pnpm run typecheck && pnpm run typecheck:worker && pnpm run test",
    "build:only": "node scripts/gen-bootstrap.mjs --force && next build && node scripts/gen-sw.mjs",
    "audyt:mobilny": "node --import tsx scripts/audyt-mobilny.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "next": "16.3.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.131.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
